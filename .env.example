# EstateOS Environment Variables

# Database Connection (Supabase PostgreSQL)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@bgucdmceppcshpnwdqqp.supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://bgucdmceppcshpnwdqqp.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# Redis (for distributed rate limiting and caching)
REDIS_URL="redis://localhost:6379"

# Backend & Frontend Ports
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
BACKEND_URL="http://localhost:3001"

# AI Studio Telemetry & Provider Keys (Optional: falls back to built-in domain models)
AI_PROVIDER_CHAIN="openai,anthropic,mock"
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Billing (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Meta WhatsApp Cloud API. Never commit production values.
META_APP_SECRET="..."
META_WEBHOOK_VERIFY_TOKEN="generate-a-long-random-token"
META_PHONE_NUMBER_ID="..."
META_BUSINESS_ACCOUNT_ID="..."
META_ACCESS_TOKEN="..."
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
WHATSAPP_TOKEN_ENCRYPTION_KEY="..."
# WhatsApp API version (default: v21.0)
WHATSAPP_API_VERSION="v21.0"
# Webhook rate limit per minute (default: 120)
WEBHOOK_RATE_LIMIT_PER_MINUTE="120"

# Monitoring & Health
# Health check endpoint: GET /api/health
# Sentry for error monitoring (optional but recommended)
SENTRY_DSN="..."
SENTRY_ENVIRONMENT="production"
